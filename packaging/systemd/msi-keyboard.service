[Unit]
Description=MSI Mystic Light Controller for Linux - Backlight Initialization
Documentation=https://github.com/anas-kummali/msi-mysticlight-controller-linux
After=default.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/msi-mysticlight -c white -B 10
RemainAfterExit=yes

# Sandboxing & Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
