[Unit]
Description=MSI Keyboard RGB Backlight Restore on Resume
Documentation=https://github.com/anas-kummali/msi-24zone-keyboard
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/msi-keyboard -c white -B 10

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

