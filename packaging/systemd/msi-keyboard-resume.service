[Unit]
Description=MSI Mystic Light Controller for Linux - Backlight Restore on Resume
Documentation=https://github.com/anas-kummali/msi-mysticlight-controller-linux
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/msi-mysticlight -c white -B 10

# Sandboxing & Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
