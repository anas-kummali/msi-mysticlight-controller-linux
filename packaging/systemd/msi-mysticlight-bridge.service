[Unit]
Description=MSI Mystic Light - OS Tray & Sysfs Backlight Bridge
Documentation=https://github.com/anas-kummali/msi-mysticlight-controller-linux
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/msi-mysticlight --bridge
Restart=on-failure
RestartSec=3

# Sandboxing & Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
