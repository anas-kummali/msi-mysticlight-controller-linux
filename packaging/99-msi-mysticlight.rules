# MSI MysticLight USB HID permissions for non-root keyboard control
# Permits desktop user access via uaccess / plugdev

# MSI Vector 16 HX AI (MS-1603) 24-Zone
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="1603", MODE="0666", TAG+="uaccess"

# MSI Vector A18 HX (MS-1605) 24-Zone
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="1605", MODE="0666", TAG+="uaccess"

# MSI Crosshair 16 Max HX (MS-1801)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="1801", MODE="0666", TAG+="uaccess"

# MSI Katana 15 HX (MS-1565)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="1601", MODE="0666", TAG+="uaccess"

# MSI Generic MysticLight matchers
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", MODE="0666", TAG+="uaccess"

