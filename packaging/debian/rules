#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	cargo build --release --bin msi-mysticlight --bin msi-mysticlight-gui

override_dh_auto_install:
	install -Dm755 target/release/msi-mysticlight debian/msi-mysticlight/usr/bin/msi-mysticlight
	install -Dm755 target/release/msi-mysticlight-gui debian/msi-mysticlight/usr/bin/msi-mysticlight-gui
	ln -sf msi-mysticlight debian/msi-mysticlight/usr/bin/msi-keyboard
	ln -sf msi-mysticlight debian/msi-mysticlight/usr/bin/msi-rgb
	install -Dm644 packaging/99-msi-mysticlight.rules debian/msi-mysticlight/usr/lib/udev/rules.d/99-msi-mysticlight.rules
	install -Dm644 packaging/systemd/msi-keyboard.service debian/msi-mysticlight/usr/lib/systemd/user/msi-keyboard.service
	install -Dm644 packaging/systemd/msi-keyboard-resume.service debian/msi-mysticlight/usr/lib/systemd/user/msi-keyboard-resume.service
	install -Dm644 packaging/msi-mysticlight.desktop debian/msi-mysticlight/usr/share/applications/msi-mysticlight.desktop
	install -Dm644 packaging/icons/msi-mysticlight.svg debian/msi-mysticlight/usr/share/icons/hicolor/scalable/apps/msi-mysticlight.svg

